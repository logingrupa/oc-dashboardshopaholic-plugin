{
    "name": "logingrupa/oc-dashboardshopaholic-plugin",
    "type": "october-plugin",
    "description": "October CMS v4 dashboard for the Lovata Shopaholic ecosystem: order status buckets, exact turnover, price-type based profit metrics and a live new-orders widget.",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.3",
        "october/system": "^4.0",
        "october/rain": "^4.0",
        "composer/installers": "~1.0 || ~2.0",
        "lovata/toolbox-plugin": "^2.2",
        "lovata/shopaholic-plugin": "^1.32",
        "lovata/ordersshopaholic-plugin": "^1.33"
    },
    "authors": [
        {
            "name": "Logingrupa",
            "email": "info@logingrupa.lv"
        }
    ],
    "autoload": {
        "psr-4": {
            "Logingrupa\\DashboardShopaholic\\": ""
        }
    },
    "scripts": {
        "test": "../../../vendor/bin/pest --configuration phpunit.xml",
        "analyse": "../../../vendor/bin/phpstan analyse --configuration=phpstan.neon",
        "baseline": "../../../vendor/bin/phpstan analyse --configuration=phpstan.neon --generate-baseline=phpstan-baseline.neon",
        "phpmd": "../../../vendor/bin/phpmd classes,models,console,vuecomponents/NewOrdersList.php,Plugin.php text phpmd.xml",
        "pint": "../../../vendor/bin/pint . --config=pint.json",
        "pint-test": "../../../vendor/bin/pint . --config=pint.json --test",
        "rector-dry": "../../../vendor/bin/rector process --config=rector.php --dry-run",
        "rector": "../../../vendor/bin/rector process --config=rector.php",
        "qa": [
            "@pint-test",
            "@analyse",
            "@phpmd",
            "@test"
        ]
    }
}
